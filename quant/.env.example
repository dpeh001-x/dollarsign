# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed.
# NEVER paste real keys into .env.example.

# ─── Alpaca (https://alpaca.markets) ───
# Free signup. Use paper trading keys to start. Real-time IEX data on free tier;
# full SIP feed requires a paid subscription. Paper and live keys are different.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# ─── Polygon.io (https://polygon.io) ───
# Free tier: 5 calls/min, 2 years of historical aggregates on stocks/forex/crypto.
# Paid plans lift the rate limit and add real-time / 20-year history.
POLYGON_API_KEY=

# ─── NewsAPI.org (https://newsapi.org) ───
# Developer tier (free) is for non-production use only: 100 reqs/day,
# articles delayed 24h, dev environments only. Production needs a paid plan.
NEWSAPI_KEY=
