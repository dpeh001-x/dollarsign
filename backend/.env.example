# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed.
# NEVER paste real keys into .env.example.

# ─── Reddit OAuth (https://www.reddit.com/prefs/apps) ───
# Create a "script" type app. Set redirect URI to http://localhost:8080.
# Copy the client ID (under app name) and secret. Empty values disable
# the sentiment feed (it returns []).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=oracle-prediction-platform/0.1 by your_username

# ─── Kalshi (https://kalshi.com/account/api-keys) ───
# Public market data is fetched without auth. These keys are reserved for
# future trading / private endpoints, which require RSA-signed requests.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# ─── NewsAPI.org (https://newsapi.org) ───
# Used for news sentiment around prediction-market questions. Developer
# tier is dev-only (100 reqs/day, 24h article delay).
NEWSAPI_KEY=

# ─── Polymarket ───
# No credentials needed for the Gamma public market API.
